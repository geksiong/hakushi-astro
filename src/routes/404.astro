---
import config from 'virtual:hakushi/config';
import { BaseLayout, Header } from 'virtual:hakushi/components';
---

<BaseLayout title={`${config.notFound.title} · ${config.title}`}>
	<Header view="reader" />
	<main class="flex-1 flex items-center justify-center p-12 text-center text-[var(--text-muted)]">
		<div><h1 class="text-4xl font-bold text-[var(--primary)] mb-3 font-heading">{config.notFound.title}</h1>{config.notFound.text.split(/\n\s*\n/).map((paragraph) => <p class="max-w-prose mx-auto mt-2 whitespace-pre-line">{paragraph}</p>)}<a href="/" class="inline-block mt-6 px-4 py-2 rounded-lg bg-[var(--primary)] text-white font-medium">Back to {config.title}</a></div>
	</main>
</BaseLayout>
