---
import config from 'virtual:hakushi/config';
import { BaseLayout, Header } from 'virtual:hakushi/components';
---

<BaseLayout title={`Not Found · ${config.title}`}>
	<Header view="reader" />
	<main class="flex-1 flex items-center justify-center p-12 text-center text-[var(--text-muted)] font-mono">
		<div><p class="text-4xl font-bold text-[var(--primary)] mb-3 font-heading">404</p><p>No note found at this path.</p><a href="/" class="inline-block mt-6 px-4 py-2 rounded-lg bg-[var(--primary)] text-white font-medium">Back to {config.title}</a></div>
	</main>
</BaseLayout>
