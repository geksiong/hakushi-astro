---
import config from 'virtual:hakushi/config';
import { BaseLayout, Header, ReaderShell } from 'virtual:hakushi/components';
import GraphBrowser from '../components/GraphBrowser';
import { getCachedGraph } from '../lib/graph-data';
const graph = await getCachedGraph();
---

<BaseLayout title={`Knowledge Graph · ${config.title}`} description={`Interactive knowledge graph for ${config.title}.`}>
	<Header view="graph" />
	<ReaderShell isGraphPage>
		<main class="flex-1 p-4 max-w-7xl w-full mx-auto">
			<GraphBrowser client:load graph={graph} />
		</main>
	</ReaderShell>
</BaseLayout>
