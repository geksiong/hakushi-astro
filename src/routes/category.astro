---
import { getCollection } from 'astro:content';
import { Folder, ChevronRight } from '@lucide/astro';
import config from 'virtual:hakushi/config';
import { BaseLayout, Header, ReaderShell } from 'virtual:hakushi/components';
import { getCollectionConfig } from '../lib/collections';
import { taxonomySlug } from '../lib/graph-data';

export async function getStaticPaths() {
	const config = (await import('virtual:hakushi/config')).default;
	const byCategory = new Map<string, { name: string; articles: any[] }>();
	for (const { id } of config.collections) {
		const entries = await (getCollection as any)(id, ({ data }: any) => !data.draft);
		for (const doc of entries) if (doc.data.category) {
			const slug = taxonomySlug(doc.data.category);
			if (!byCategory.has(slug)) byCategory.set(slug, { name: doc.data.category, articles: [] });
			byCategory.get(slug)!.articles.push({ title: doc.data.title, summary: doc.data.summary ?? '', date: String(doc.data.date ?? ''), url: `/${doc.id}`, collection: id });
		}
	}
	return [...byCategory].map(([category, props]) => ({ params: { category }, props }));
}
const { name, articles } = Astro.props;
articles.sort((a: any, b: any) => b.date.localeCompare(a.date));
---

<BaseLayout title={`${name} · ${config.title}`} description={`Articles in the ${name} category.`}>
	<Header view="reader" />
	<ReaderShell>
	<main class="flex-1 w-full max-w-4xl mx-auto px-4 py-8 space-y-6">
		<div class="space-y-2">
			<a href="/graph" class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--primary)]">Knowledge Graph <ChevronRight class="inline w-3.5 h-3.5" /></a>
			<h1 class="flex items-center gap-2 text-3xl font-extrabold text-[var(--text-main)] font-heading"><Folder class="w-5 h-5 text-[var(--accent)]" />{name}</h1>
			<p class="text-xs text-[var(--text-muted)] font-mono">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</p>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">{articles.map((article: any) => <a href={article.url} class="p-4 rounded-lg border border-[var(--border)] bg-[var(--bg-surface)] hover:border-[var(--primary)]"><p class="font-semibold text-sm text-[var(--text-main)]">{article.title}</p><p class="text-xs text-[var(--text-muted)] line-clamp-2 mt-1.5">{article.summary}</p><div class="flex justify-between mt-3 text-[11px] font-mono text-[var(--text-muted)]"><span>{getCollectionConfig(article.collection)?.name ?? article.collection}</span><span>{article.date}</span></div></a>)}</div>
	</main>
	</ReaderShell>
</BaseLayout>
