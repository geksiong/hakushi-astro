---
import { getCollection } from 'astro:content';
import { Tag, ChevronRight } from '@lucide/astro';
import config from 'virtual:hakushi/config';
import { BaseLayout, Header, ReaderShell } from 'virtual:hakushi/components';
import ArticleListing from '../components/ArticleListing';
import { resolveEntryTitle } from '../lib/title';
import { taxonomySlug } from '../lib/graph-data';

export async function getStaticPaths() {
	const config = (await import('virtual:hakushi/config')).default;
	const byTag = new Map<string, { name: string; articles: any[] }>();
	for (const { id } of config.collections) {
		const entries = await (getCollection as any)(id, ({ data }: any) => !data.draft);
		for (const doc of entries) for (const tag of doc.data.tags ?? []) {
			const slug = taxonomySlug(tag);
			if (!byTag.has(slug)) byTag.set(slug, { name: tag, articles: [] });
			byTag.get(slug)!.articles.push({ title: resolveEntryTitle(doc), summary: doc.data.summary ?? '', date: doc.data.date?.toISOString().slice(0, 10) ?? '', url: `/${doc.id}`, collection: id, mainImage: doc.data.mainImage });
		}
	}
	return [...byTag].map(([tag, props]) => ({ params: { tag }, props }));
}
const { name, articles } = Astro.props;
articles.sort((a: any, b: any) => b.date.localeCompare(a.date));
---

<BaseLayout title={`#${name} · ${config.title}`} description={`Articles tagged #${name}.`}>
	<Header view="reader" />
	<ReaderShell>
		<main class="flex-1 w-full article-container space-y-6">
			<div class="space-y-2">
				<a href="/graph" class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--primary)]">Knowledge Graph <ChevronRight class="inline w-3.5 h-3.5" /></a>
				<h1 class="flex items-center gap-2 text-3xl font-extrabold text-[var(--text-main)] font-heading"><Tag class="w-5 h-5 text-[var(--secondary)]" />#{name}</h1>
				<p class="text-xs text-[var(--text-muted)] font-mono">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</p>
			</div>
			<ArticleListing client:load articles={articles} collections={config.collections} storageKey={`hakushi_listing_layout:tag:${Astro.params.tag}`} />
		</main>
	</ReaderShell>
</BaseLayout>
