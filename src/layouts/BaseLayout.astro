---
import 'virtual:hakushi/styles';
import config from 'virtual:hakushi/config';
import { createThemeInitScript } from '../lib/theme-init.mjs';
import { createSidebarInitScript } from '../lib/sidebar-init.mjs';
import CommandPalette from '../components/CommandPalette';
import MobileNav from '../components/MobileNav';
import { getSearchDocs } from '../lib/search-data';
import { getArticleIndex } from '../lib/articles';
import { COLLECTIONS } from '../lib/collections';
import { SIDEBAR_LINKS } from '../lib/sidebar';

interface Props {
	title?: string;
	description?: string;
}

const { title = config.title, description = config.description } = Astro.props;

const searchDocs = await getSearchDocs();
const articles = await getArticleIndex();
---

<!doctype html>
<html lang={config.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{config.favicon && <link rel="icon" href={config.favicon} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=JetBrains+Mono:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap"
		/>
		<script is:inline set:html={createThemeInitScript(config.theme)} />
		<script is:inline set:html={createSidebarInitScript()} />
	</head>
	<body class="min-h-screen flex flex-col antialiased">
		<slot />

		<MobileNav client:load collections={COLLECTIONS} articles={articles} links={SIDEBAR_LINKS} />
		<CommandPalette client:load docs={searchDocs} />
	</body>
</html>
