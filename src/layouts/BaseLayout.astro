---
import 'virtual:hakushi/styles';
import config from 'virtual:hakushi/config';
import { createThemeInitScript } from '../lib/theme-init.mjs';
import { createSidebarInitScript } from '../lib/sidebar-init.mjs';
import CommandPalette from '../components/CommandPalette';
import MobileNav from '../components/MobileNav';
import FloatingControls from '../components/FloatingControls.astro';
import { Footer } from 'virtual:hakushi/components';
import { getSearchDocs } from '../lib/search-data';
import { getArticleIndex } from '../lib/articles';
import { COLLECTIONS } from '../lib/collections';
import { SIDEBAR_LINKS } from '../lib/sidebar';

interface Props {
	title?: string;
	description?: string;
}

const { title = config.title, description = config.description } = Astro.props;

// Webfonts: the inline theme script links the active typography style's
// stylesheet(s). Without JavaScript, the default style's fonts load instead.
const styles = config.theme.styles as Record<string, { stylesheet?: string | string[] }>;
const defaultFontSheets = ([] as string[]).concat(styles[config.theme.style]?.stylesheet ?? []);
const usesGoogleFonts = Object.values(styles).some((style) =>
	([] as string[]).concat(style.stylesheet ?? []).some((href) => href.startsWith('https://fonts.googleapis.com/'))
);

// Google Analytics loads in production builds only, so dev traffic isn't counted.
const gaId = import.meta.env.PROD ? config.googleAnalytics : null;
const gaInit = gaId
	? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`
	: '';

const searchDocs = await getSearchDocs();
const articles = await getArticleIndex();
---

<!doctype html>
<html lang={config.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{config.favicons.map((icon) => <link rel={icon.rel} href={icon.href} type={icon.type} sizes={icon.sizes} />)}
		{usesGoogleFonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
		{usesGoogleFonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
		{defaultFontSheets.length > 0 && (
			<noscript>{defaultFontSheets.map((href) => <link rel="stylesheet" href={href} />)}</noscript>
		)}
		<script is:inline set:html={createThemeInitScript(config.theme)} />
		<script is:inline set:html={createSidebarInitScript()} />
		{gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`} />}
		{gaId && <script is:inline set:html={gaInit} />}
	</head>
	<body class="min-h-screen flex flex-col antialiased">
		<slot />
		<Footer />

		<MobileNav client:load collections={COLLECTIONS} articles={articles} links={SIDEBAR_LINKS} />
		<CommandPalette client:load docs={searchDocs} />
		<FloatingControls />
	</body>
</html>
