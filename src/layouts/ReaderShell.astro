---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar';
import RightToc from '../components/RightToc.astro';
import { getArticleIndex } from '../lib/articles';
import { COLLECTIONS } from '../lib/collections';
import type { GraphJSON } from '../lib/graph-data';

interface Props {
	entry?: any;
	currentCollection?: string;
	headings?: { depth: number; text: string; slug: string }[];
	subgraph?: GraphJSON;
	/** Rendered on /graph: no collection is selected, the graph link is active. */
	isGraphPage?: boolean;
}

const { entry, currentCollection, headings, subgraph, isGraphPage = false } = Astro.props;
const articles = await getArticleIndex();
const activeCollection = currentCollection ?? entry?.collection;
---

<div
	class="flex-1 max-w-7xl w-full mx-auto flex items-start bg-[var(--bg-main)] transition-colors duration-200"
>
	<!-- Left Navigation Sidebar -->
	<Sidebar
		client:load
		collections={COLLECTIONS}
		articles={articles}
		currentSlug={entry?.id ?? ''}
		selectedCollectionId={activeCollection}
		isGraphPage={isGraphPage}
	/>

	<!-- Central Article Viewer / Collection Browser -->
	<main class="flex-1 min-w-0 pb-16">
		<slot />
	</main>

	<!-- Right Table of Contents Sidebar -->
	{headings && entry && subgraph && (
		<RightToc headings={headings} slug={entry.id} subgraph={subgraph} />
	)}
</div>
