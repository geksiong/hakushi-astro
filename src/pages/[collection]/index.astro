---
import { COLLECTIONS } from '../../lib/collections';
import { getArticleIndex } from '../../lib/articles';
import CollectionPage from '../../components/CollectionPage.astro';

export async function getStaticPaths() {
	return COLLECTIONS.map((c) => ({
		params: { collection: c.id },
		props: { collection: c },
	}));
}

const { collection } = Astro.props;
const allArticles = await getArticleIndex();
const articles = allArticles.filter((a) => a.collection === collection.id);
---

<CollectionPage collection={collection} articles={articles} />
