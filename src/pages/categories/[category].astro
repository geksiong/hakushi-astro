---
import { getCollection } from 'astro:content';
import { Folder, ChevronRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ReaderShell from '../../layouts/ReaderShell.astro';
import { COLLECTIONS } from '../../lib/collections';
import ArticleListing from '../../components/ArticleListing';
import { resolveEntryTitle } from '../../lib/title';
import { taxonomySlug } from '../../lib/graph-data';

interface ArticleCard {
	title: string;
	summary: string;
	date: string;
	url: string;
	collection: string;
	mainImage?: string;
}

interface Props {
	name: string;
	articles: ArticleCard[];
}

export async function getStaticPaths() {
	const groups = await Promise.all(
		COLLECTIONS.map(async ({ id }) => ({
			id,
			entries: await getCollection(id as 'docs', ({ data }) => !data.draft),
		}))
	);

	const byCategory = new Map<string, { name: string; articles: ArticleCard[] }>();

	for (const { id, entries } of groups) {
		for (const doc of entries) {
			if (!doc.data.category) continue;
			const slug = taxonomySlug(doc.data.category);
			if (!slug) continue;
			if (!byCategory.has(slug)) byCategory.set(slug, { name: doc.data.category, articles: [] });
			byCategory.get(slug)!.articles.push({
				title: resolveEntryTitle(doc),
				summary: doc.data.summary ?? '',
				date: doc.data.date?.toISOString().slice(0, 10) ?? '',
				url: `/${doc.id}`,
				collection: id,
				mainImage: doc.data.mainImage,
			});
		}
	}

	return Array.from(byCategory.entries()).map(([slug, { name, articles }]) => ({
		params: { category: slug },
		props: { name, articles },
	}));
}

const { name, articles } = Astro.props;

articles.sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title={`${name} · Hakushi`} description={`Articles in the ${name} category.`}>
	<Header view="reader" />
	<ReaderShell>
	<main class="flex-1 w-full article-container space-y-6">
		<div class="space-y-2">
			<div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
				<a href="/graph" class="hover:text-[var(--primary)] transition-colors">Knowledge Graph</a>
				<ChevronRight class="w-3.5 h-3.5" />
				<span class="text-[var(--text-main)] font-medium">Categories</span>
			</div>

			<h1
				class="flex items-center gap-2 text-3xl font-extrabold tracking-tight text-[var(--text-main)] font-heading"
			>
				<span
					class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] font-semibold"
				>
					<Folder class="w-5 h-5" />
					{name}
				</span>
			</h1>
			<p class="text-xs text-[var(--text-muted)] font-mono">
				{articles.length} {articles.length === 1 ? 'article' : 'articles'}
			</p>
		</div>

		<ArticleListing client:load articles={articles} collections={COLLECTIONS} storageKey={`hakushi_listing_layout:category:${Astro.params.category}`} />
	</main>
	</ReaderShell>
</BaseLayout>
