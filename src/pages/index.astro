---
import { COLLECTIONS } from '../lib/collections';
import { getArticleIndex } from '../lib/articles';
import CollectionPage from '../components/CollectionPage.astro';

const articles = await getArticleIndex();

const collection = {
	id: 'all',
	name: 'All Collections',
	description: `Browse every article across all ${COLLECTIONS.length} collections.`,
	iconName: 'Layers',
} as any;
---

<CollectionPage collection={collection} articles={articles} />
