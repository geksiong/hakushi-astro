---
import { ChevronDown } from '@lucide/astro';
import GraphBrowser from './GraphBrowser';
import type { GraphJSON } from '../lib/graph-data';

interface Props {
	headings: { depth: number; text: string; slug: string }[];
	slug: string;
	subgraph: GraphJSON;
}

const { headings = [], slug, subgraph } = Astro.props;
const toc = headings.filter((h) => h.depth <= 4);
---

<aside
	id="right-sidebar"
	class="shrink-0 hidden lg:block sticky top-20 self-start w-64 pt-4 text-xs max-h-[calc(100vh-6rem)] overflow-y-auto space-y-8"
>
	<!-- Table of Contents -->
	{
		toc.length > 0 && (
			<nav aria-label="On this page" class="space-y-2">
				<p class="text-[var(--text-muted)]">On this page</p>
				<div class="border-l border-[var(--border)]">
					{toc.map((item) => (
						<a
							href={`#${item.slug}`}
							data-toc-link={item.slug}
							class:list={[
								'-ml-px block truncate py-1 pr-2 border-l-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors',
								item.depth <= 2 ? 'pl-3' : 'pl-6',
							]}
						>
							{item.text}
						</a>
					))}
				</div>
			</nav>
		)
	}

	<!-- Article Local Knowledge Graph Subset -->
	<div class="space-y-2">
		<button
			id="toggle-local-graph"
			type="button"
			aria-expanded="true"
			aria-controls="local-graph-body"
			class="w-full flex items-center justify-between text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
		>
			Graph
			<ChevronDown class="w-3.5 h-3.5 transition-transform" />
		</button>

		<div id="local-graph-body">
			<GraphBrowser client:idle graph={subgraph} focus={slug} isSubGraph />
		</div>
	</div>
</aside>

<script>
	// Local graph toggle
	const toggle = document.getElementById('toggle-local-graph');
	const body = document.getElementById('local-graph-body');
	toggle?.addEventListener('click', () => {
		if (!body) return;
		const hidden = body.style.display === 'none';
		body.style.display = hidden ? '' : 'none';
		toggle.setAttribute('aria-expanded', String(hidden));
		toggle.querySelector('svg')?.classList.toggle('-rotate-90', !hidden);
	});

	// Active section highlighting
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
	const byId = new Map(links.map((l) => [l.dataset.tocLink!, l]));
	let activeId = '';

	const setActive = (id: string) => {
		if (id === activeId) return;
		activeId = id;
		for (const [id2, link] of byId) {
			const selected = id2 === id;
			link.classList.toggle('border-[var(--primary)]', selected);
			link.classList.toggle('border-transparent', !selected);
			link.classList.toggle('text-[var(--text-main)]', selected);
			link.classList.toggle('text-[var(--text-muted)]', !selected);
		}
	};

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) setActive(entry.target.id);
			}
		},
		{ rootMargin: '-80px 0px -60% 0px' }
	);

	links.forEach((link) => {
		const el = document.getElementById(link.dataset.tocLink!);
		if (el) observer.observe(el);
	});

	// Smooth scroll on click
	links.forEach((link) => {
		link.addEventListener('click', (e) => {
			const el = document.getElementById(link.dataset.tocLink!);
			if (!el) return;
			e.preventDefault();
			el.scrollIntoView({ behavior: 'smooth' });
			setActive(link.dataset.tocLink!);
		});
	});
</script>
