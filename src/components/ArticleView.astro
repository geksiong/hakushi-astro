---
import { ChevronRight, ChevronDown, Calendar, Clock, User, Tag, List } from '@lucide/astro';
import { getCollectionConfig } from '../lib/collections';
import { resolveEntryTitle } from '../lib/title';
import { taxonomySlug } from '../lib/slugs';
import type { ReadingTime, Backlink } from '../lib/articles';
import config from 'virtual:hakushi/config';

interface Props {
	entry: any;
	Content: any;
	headings: { depth: number; text: string; slug: string }[];
	readingTime: ReadingTime;
	backlinks: Backlink[];
}

const { entry, Content, headings, readingTime, backlinks } = Astro.props;
const data = entry.data;
const displayTitle = resolveEntryTitle(entry);
const colConfig = getCollectionConfig(entry.collection);
const colName = colConfig?.name ?? entry.collection;
const toc = headings.filter((h) => h.depth <= 4);
// Frontmatter dates are calendar days parsed as UTC midnight - format in UTC
// so the day never shifts with the build machine's timezone.
const date: Date | undefined = data.date;
const displayDate = date?.toLocaleDateString(config.lang, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<article class="article-container space-y-6">
	<!-- Breadcrumb Path -->
	<div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
		<a href={`/${entry.collection}`} class="capitalize hover:text-[var(--primary)] transition-colors">{colName}</a>
		<ChevronRight class="w-3.5 h-3.5" />
		{
			data.category && (
				<>
					<span>{data.category}</span>
					<ChevronRight class="w-3.5 h-3.5" />
				</>
			)
		}
		<span class="text-[var(--text-main)] font-medium truncate">{displayTitle}</span>
	</div>

	<!-- Article Header -->
	<header class="space-y-4 pb-6 border-b border-[var(--border)]">
		<h1
			class="font-extrabold tracking-tight text-[var(--text-main)] font-heading leading-tight"
			style="font-size: calc(var(--font-size-h1, 2.15rem) * 1.15);"
		>
			{displayTitle}
		</h1>

		<!-- Metadata -->
		<div class="flex flex-wrap items-center gap-4 text-xs text-[var(--text-muted)]">
			{
				date && (
					<div class="flex items-center gap-1.5">
						<Calendar class="w-3.5 h-3.5" />
						<time datetime={date.toISOString().slice(0, 10)}>{displayDate}</time>
					</div>
				)
			}

			<div class="flex items-center gap-1.5">
				<Clock class="w-3.5 h-3.5" />
				<span>{readingTime.minutes} min read ({readingTime.words} words)</span>
			</div>

			{
				data.author && (
					<div class="flex items-center gap-1.5">
						<User class="w-3.5 h-3.5" />
						<span>{data.author}</span>
					</div>
				)
			}
		</div>

		<!-- Summary -->
		{
			data.summary && (
				<p class="pl-4 border-l-2 border-[var(--primary)]/50 text-sm text-[var(--text-muted)] leading-relaxed italic">
					{data.summary}
				</p>
			)
		}

		<!-- Tags -->
		{
			data.tags.length > 0 && (
				<div class="flex flex-wrap items-center gap-2 pt-2">
					{data.tags.map((tag) => (
						<a
							href={`/tags/${taxonomySlug(tag)}`}
							class="inline-flex items-center gap-1 text-xs font-mono text-[var(--primary)] hover:underline transition-colors"
						>
							<Tag class="w-3 h-3" />
							#{tag}
						</a>
					))}
				</div>
			)
		}
	</header>

	{data.mainImage && (
		<figure class="overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--bg-surface)]">
			<img src={data.mainImage} alt={displayTitle} class="block w-full max-h-[36rem] object-contain" />
		</figure>
	)}

	<!-- Mobile "On This Page" (the right-hand TOC card is hidden below lg) -->
	{
		toc.length > 0 && (
			<details class="lg:hidden group rounded-lg border border-[var(--border)]">
				<summary class="flex items-center justify-between p-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
						<span class="font-bold text-[var(--text-main)] uppercase tracking-wider text-xs flex items-center gap-1.5">
							<List class="w-3.5 h-3.5" />
							On This Page
						</span>
					<ChevronDown class="w-4 h-4 text-[var(--text-muted)] transition-transform group-open:rotate-180" />
				</summary>
				<nav class="space-y-1 px-4 pb-4">
					{toc.map((item) => (
						<a
							href={`#${item.slug}`}
							class:list={[
								'block w-full text-left py-1.5 px-2 rounded-md transition-colors truncate',
								item.depth === 1
									? 'pl-0 font-semibold'
									: item.depth === 2
										? 'pl-2 font-medium'
										: 'pl-4 text-[11px] text-[var(--text-muted)]',
							]}
						>
							{item.text}
						</a>
					))}
				</nav>
			</details>
		)
	}

	<!-- Main Formatted Article Content -->
	<div class="md-body max-w-none space-y-4">
		<Content />
	</div>

	<!-- Backlinks / Linked References -->
	{
		backlinks.length > 0 && (
			<section class="mt-12 pt-6 border-t border-[var(--border)] space-y-2">
				<h3 class="text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
					Linked References <span class="font-mono normal-case">· {backlinks.length}</span>
				</h3>
				<nav class="space-y-0.5">
					{backlinks.map((bl) => (
						<a
							href={`/${bl.slug}`}
							title={bl.title}
							class="block truncate py-1 text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
						>
							{bl.title}
						</a>
					))}
				</nav>
			</section>
		)
	}
</article>
