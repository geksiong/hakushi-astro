---
import { ChevronRight, ChevronDown, Pause, Play, Square, Volume2 } from '@lucide/astro';
import { getCollectionConfig } from '../lib/collections';
import { resolveEntryTitle } from '../lib/title';
import { taxonomySlug } from '../lib/slugs';
import type { ReadingTime, Backlink } from '../lib/articles';
import { formatDate } from '../lib/dates';
import config from 'virtual:hakushi/config';

interface Props {
	entry: any;
	Content: any;
	headings: { depth: number; text: string; slug: string }[];
	readingTime: ReadingTime;
	backlinks: Backlink[];
}

const { entry, Content, headings, readingTime, backlinks } = Astro.props;
const data = entry.data;
const displayTitle = resolveEntryTitle(entry);
const colConfig = getCollectionConfig(entry.collection);
const colName = colConfig?.name ?? entry.collection;
const toc = headings.filter((h) => h.depth <= 4);
const date: Date | undefined = data.date;
const displayDate = formatDate(date);
---

<article class="article-container space-y-6">
	<!-- Breadcrumb Path -->
	<div class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
		<a href={`/${entry.collection}`} class="capitalize hover:text-[var(--primary)] transition-colors">{colName}</a>
		<ChevronRight class="w-3.5 h-3.5" />
		{
			data.category && (
				<>
					<a href={`/categories/${taxonomySlug(data.category)}`} class="hover:text-[var(--primary)] transition-colors">
						{data.category}
					</a>
					<ChevronRight class="w-3.5 h-3.5" />
				</>
			)
		}
		<span class="text-[var(--text-main)] font-medium truncate">{displayTitle}</span>
	</div>

	<!-- Article Header -->
	<header class="space-y-3 pb-6 border-b border-[var(--border)]">
		<h1
			data-read-aloud
			class="font-extrabold tracking-tight text-[var(--text-main)] font-heading leading-tight"
			style="font-size: calc(var(--font-size-h1, 2.15rem) * 1.15);"
		>
			{displayTitle}
		</h1>

		{data.summary && <p data-read-aloud class="text-base text-[var(--text-muted)] leading-relaxed">{data.summary}</p>}

		<p class="text-xs text-[var(--text-muted)]">
			{date && <time datetime={date.toISOString().slice(0, 10)}>{displayDate}</time>}
			{date && ' · '}
			{readingTime.minutes} min read
			{data.author && ` · ${data.author}`}
			{
				config.readAloud && (
					<span id="read-aloud" hidden>
						{' · '}
						<button
							type="button"
							data-read-aloud-toggle
							aria-label="Read article aloud"
							title="Read article aloud"
							class="inline-flex items-center align-middle -mt-px hover:text-[var(--text-main)] transition-colors"
						>
							<span data-read-aloud-label class="inline-flex items-center gap-1">
								<Volume2 class="w-3.5 h-3.5" />
								Listen
							</span>
							<Pause data-read-aloud-icon="pause" class="w-3.5 h-3.5" hidden />
							<Play data-read-aloud-icon="play" class="w-3.5 h-3.5" hidden />
						</button>
						<button
							type="button"
							data-read-aloud-stop
							aria-label="Stop reading"
							title="Stop reading"
							class="ml-2 inline-flex items-center align-middle -mt-px hover:text-[var(--text-main)] transition-colors"
							hidden
						>
							<Square class="w-3.5 h-3.5" />
						</button>
					</span>
				)
			}
		</p>
	</header>

	{data.mainImage && (
		<figure class="overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--bg-surface)]">
			<img src={data.mainImage} alt={displayTitle} class="block w-full max-h-[36rem] object-contain" />
		</figure>
	)}

	<!-- Mobile "On This Page" (the right-hand TOC card is hidden below lg) -->
	{
		toc.length > 0 && (
			<details class="lg:hidden group rounded-lg border border-[var(--border)]">
				<summary class="flex items-center justify-between p-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
						<span class="text-xs text-[var(--text-muted)]">On this page</span>
					<ChevronDown class="w-4 h-4 text-[var(--text-muted)] transition-transform group-open:rotate-180" />
				</summary>
				<nav class="space-y-1 px-4 pb-4">
					{toc.map((item) => (
						<a
							href={`#${item.slug}`}
							class:list={[
								'block w-full text-left py-1.5 px-2 rounded-md transition-colors truncate',
								item.depth === 1
									? 'pl-0 font-semibold'
									: item.depth === 2
										? 'pl-2 font-medium'
										: 'pl-4 text-[11px] text-[var(--text-muted)]',
							]}
						>
							{item.text}
						</a>
					))}
				</nav>
			</details>
		)
	}

	<!-- Main Formatted Article Content -->
	<div data-read-aloud class="md-body max-w-none space-y-4">
		<Content />
	</div>

	<!-- Tags and Linked References -->
	{
		(data.tags.length > 0 || backlinks.length > 0) && (
			<footer class="mt-12 pt-6 border-t border-[var(--border)] space-y-6">
				{data.tags.length > 0 && (
					<nav aria-label="Tags" class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
						{data.tags.map((tag) => (
							<a
								href={`/tags/${taxonomySlug(tag)}`}
								class="text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors"
							>
								#{tag}
							</a>
						))}
					</nav>
				)}

				{backlinks.length > 0 && (
					<section class="space-y-2">
						<h3 class="text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
							Linked References <span class="normal-case">· {backlinks.length}</span>
						</h3>
						<nav class="space-y-0.5">
							{backlinks.map((bl) => (
								<a
									href={`/${bl.slug}`}
									title={bl.title}
									class="block truncate py-1 text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors"
								>
									{bl.title}
								</a>
							))}
						</nav>
					</section>
				)}
			</footer>
		)
	}
</article>

<script>
	import { setupReadAloud } from '../scripts/read-aloud';

	setupReadAloud();
</script>
