---
import {
	Sparkles,
	Search,
	Menu,
	BookOpen,
	Calendar,
	Microscope,
	FileText,
	Share2,
	Folder,
	Layers,
	Info,
	Link as LinkIcon,
	Globe,
	Mail,
	GitFork,
	ExternalLink,
	Home,
	Rss,
	MessageCircle,
	Network,
	AtSign,
	Send,
} from '@lucide/astro';
import ThemeMenu from './ThemeMenu';
import config from 'virtual:hakushi/config';

interface Props {
	view?: 'reader' | 'graph';
}

// Icon-only links on the right side of the header (social/contact links).
// 'Github' maps to a git stand-in - lucide dropped brand icons.
const HEADER_ICONS: Record<string, any> = {
	BookOpen,
	Calendar,
	Microscope,
	FileText,
	Share2,
	Folder,
	Layers,
	Info,
	Link: LinkIcon,
	Globe,
	Mail,
	GitFork,
	Github: GitFork,
	ExternalLink,
	Home,
	Rss,
	MessageCircle,
	Network,
	AtSign,
	Send,
};

const headerLinks = config.headerLinks ?? [];
---

<header
	class="sticky top-0 z-30 w-full bg-[var(--bg-main)]/80 backdrop-blur-md border-b border-[var(--border)] px-4 py-3 transition-colors duration-200"
>
	<div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
		<!-- Left: Mobile Menu Toggle + Brand Logo & Title -->
		<div class="flex items-center gap-3">
			<button
				id="open-sidebar"
				type="button"
				aria-label="Open navigation menu"
				class="lg:hidden p-2 rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-sidebar)] hover:text-[var(--text-main)] transition-colors"
			>
				<Menu class="w-5 h-5" />
			</button>
			<a href="/" class="flex items-center gap-3">
				<div
					class="w-8 h-8 rounded-lg bg-[var(--primary)]/10 text-[var(--primary)] flex items-center justify-center font-bold"
				>
					<Sparkles class="w-4 h-4" />
				</div>
				<div>
					<div class="flex items-center gap-2">
						<span class="font-extrabold text-base tracking-tight text-[var(--text-main)] font-heading">
							{config.title}
						</span>
						<span
							class="px-2 py-0.5 rounded-full bg-[var(--primary)]/[0.07] text-[var(--primary)] font-mono text-[10px] font-medium"
						>
							{config.versionLabel}
						</span>
					</div>
					<p class="text-[11px] text-[var(--text-muted)] hidden sm:block">
						{config.description}
					</p>
				</div>
			</a>
		</div>

		<!-- Middle: prominent search -->
		<div class="flex-1 flex justify-center px-2">
			<button
				id="open-search"
				type="button"
				title="Search (press / or ⌘K)"
				class="w-full max-w-md flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--bg-sidebar)]/60 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--border)]/40 transition-colors text-xs"
			>
				<Search class="w-3.5 h-3.5 shrink-0" />
				<span class="hidden sm:inline flex-1 text-left">Search notes...</span>
				<kbd class="hidden md:inline px-1.5 py-0.5 rounded-md bg-[var(--bg-surface)] font-mono text-[10px]">/</kbd>
				<kbd class="hidden md:inline px-1.5 py-0.5 rounded-md bg-[var(--bg-surface)] font-mono text-[10px]">⌘K</kbd>
			</button>
		</div>

		<!-- Right: configurable icon links + Theme Customizer -->
		<div class="flex items-center gap-1">
			{headerLinks.map((link) => {
				const IconComponent = HEADER_ICONS[link.iconName ?? 'Link'] || LinkIcon;
				return (
					<a
						href={link.href}
						title={link.description || link.label}
						aria-label={link.label}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
						class="p-2 rounded-md text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-sidebar)] transition-colors"
					>
						<IconComponent class="w-4 h-4" />
					</a>
				);
			})}
			{headerLinks.length > 0 && (
				<div aria-hidden="true" class="w-px h-5 bg-[var(--border)] mx-1" />
			)}
			<ThemeMenu client:load />
		</div>
	</div>
</header>

<script>
	document.getElementById('open-search')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-command-palette'));
	});

	document.getElementById('open-sidebar')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-sidebar'));
	});
</script>
