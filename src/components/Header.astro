---
import {
	Search,
	Menu,
	PanelLeftClose,
	PanelLeftOpen,
	PanelRightClose,
	PanelRightOpen,
	BookOpen,
	Calendar,
	Microscope,
	FileText,
	Share2,
	Folder,
	Layers,
	Info,
	Link as LinkIcon,
	Globe,
	Mail,
	GitFork,
	ExternalLink,
	Home,
	Rss,
	MessageCircle,
	Network,
	AtSign,
	Send,
} from '@lucide/astro';
import ThemeMenu from './ThemeMenu';
import config from 'virtual:hakushi/config';

interface Props {
	view?: 'reader' | 'graph';
}

// Icon-only links on the right side of the header (social/contact links).
// 'Github' maps to a git stand-in - lucide dropped brand icons.
const HEADER_ICONS: Record<string, any> = {
	BookOpen,
	Calendar,
	Microscope,
	FileText,
	Share2,
	Folder,
	Layers,
	Info,
	Link: LinkIcon,
	Globe,
	Mail,
	GitFork,
	Github: GitFork,
	ExternalLink,
	Home,
	Rss,
	MessageCircle,
	Network,
	AtSign,
	Send,
};

const headerLinks = config.headerLinks ?? [];
---

<header
	class="sticky top-0 z-30 w-full h-16 flex items-center bg-[var(--bg-main)]/80 backdrop-blur-md border-b border-[var(--border)] px-4 transition-colors duration-200"
>
	<div class="header-container mx-auto flex items-center justify-between gap-4">
		<!-- Left: Mobile Menu Toggle + Brand Logo & Title -->
		<div class="flex items-center gap-3">
			<button
				id="open-sidebar"
				type="button"
				aria-label="Open navigation menu"
				class="lg:hidden p-2 rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-sidebar)] hover:text-[var(--text-main)] transition-colors"
			>
				<Menu class="w-5 h-5" />
			</button>
			<button
				type="button"
				data-toggle-sidebar="left"
				aria-controls="left-sidebar"
				aria-expanded="true"
				title="Hide navigation"
				class="hidden lg:inline-flex p-2 rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-sidebar)] hover:text-[var(--text-main)] transition-colors"
			>
				<PanelLeftClose data-sidebar-icon="hide" class="w-4 h-4" />
				<PanelLeftOpen data-sidebar-icon="show" class="w-4 h-4" />
			</button>
			<a href="/" class="flex items-baseline gap-2">
				<span class="font-extrabold text-base tracking-tight text-[var(--text-main)] font-heading">
					{config.title}
				</span>
				{config.versionLabel && (
					<span class="text-[11px] text-[var(--text-muted)]">{config.versionLabel}</span>
				)}
			</a>
		</div>

		<!-- Middle: search - a full pill from sm up, an icon button on phones -->
		<div class="flex-1 flex justify-end sm:justify-center sm:px-2">
			<button
				id="open-search"
				type="button"
				aria-label="Search"
				title="Search (press /)"
				class="sm:w-full sm:max-w-md flex items-center gap-2 p-2 sm:px-3 sm:py-1.5 rounded-md sm:rounded-full sm:bg-[var(--bg-sidebar)]/60 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-sidebar)] sm:hover:bg-[var(--border)]/40 transition-colors text-xs"
			>
				<Search class="w-4 h-4 sm:w-3.5 sm:h-3.5 shrink-0" />
				<span class="hidden sm:inline flex-1 text-left">Search notes...</span>
				<kbd class="hidden md:inline px-1.5 py-0.5 rounded-md bg-[var(--bg-surface)] font-mono text-[10px]">/</kbd>
			</button>
		</div>

		<!-- Right: configurable icon links + Theme Customizer -->
		<div class="flex items-center gap-1">
			{headerLinks.map((link) => {
				const IconComponent = HEADER_ICONS[link.iconName ?? 'Link'] || LinkIcon;
				return (
					<a
						href={link.href}
						title={link.description || link.label}
						aria-label={link.label}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
						class="p-2 rounded-md text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-sidebar)] transition-colors"
					>
						<IconComponent class="w-4 h-4" />
					</a>
				);
			})}
			{headerLinks.length > 0 && (
				<div aria-hidden="true" class="w-px h-5 bg-[var(--border)] mx-1" />
			)}
			<button
				type="button"
				data-toggle-sidebar="right"
				aria-controls="right-sidebar"
				aria-expanded="true"
				title="Hide contents and graph"
				class="hidden lg:inline-flex p-2 rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-sidebar)] hover:text-[var(--text-main)] transition-colors"
			>
				<PanelRightClose data-sidebar-icon="hide" class="w-4 h-4" />
				<PanelRightOpen data-sidebar-icon="show" class="w-4 h-4" />
			</button>
			<ThemeMenu client:load />
		</div>
	</div>
</header>

<script>
	document.getElementById('open-search')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-command-palette'));
	});

	document.getElementById('open-sidebar')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-sidebar'));
	});

	// Desktop sidebar collapse toggles. The collapsed state lives as a class
	// on <html> (restored before paint by the head init script); CSS hides
	// the sidebar and swaps the icon, so this only flips the class.
	const SIDEBARS = {
		left: { className: 'hakushi-left-collapsed', key: 'hakushi_left_collapsed', label: 'navigation' },
		right: { className: 'hakushi-right-collapsed', key: 'hakushi_right_collapsed', label: 'contents and graph' },
	} as const;

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-toggle-sidebar]')) {
		const side = SIDEBARS[button.dataset.toggleSidebar as keyof typeof SIDEBARS];
		if (!side) continue;
		const sync = () => {
			const collapsed = document.documentElement.classList.contains(side.className);
			button.setAttribute('aria-expanded', String(!collapsed));
			button.title = `${collapsed ? 'Show' : 'Hide'} ${side.label}`;
		};
		sync();
		button.addEventListener('click', () => {
			const collapsed = document.documentElement.classList.toggle(side.className);
			try {
				localStorage.setItem(side.key, String(collapsed));
			} catch {
				/* storage can be unavailable */
			}
			sync();
		});
	}
</script>
