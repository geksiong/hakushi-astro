---
import config from 'virtual:hakushi/config';
import { BaseLayout, Header, ReaderShell, ArticleView } from 'virtual:hakushi/components';
import { render } from 'astro:content';
import { calculateReadingTime, getBacklinks, type ReadingTime, type Backlink } from '../lib/articles';
import { resolveEntryTitle } from '../lib/title';
import { getCachedGraph, getSubgraph } from '../lib/graph-data';

export interface ArticlePageProps {
	entry: any;
}

const { entry } = Astro.props as ArticlePageProps;

const { Content, headings } = await render(entry);
const readingTime: ReadingTime = calculateReadingTime(entry.body ?? '');
const backlinks: Backlink[] = await getBacklinks(entry.id);
const subgraph = await getSubgraph(entry.id);

const title = `${resolveEntryTitle(entry)} · ${config.title}`;
---

<BaseLayout title={title} description={entry.data.summary ?? config.description}>
	<Header view="reader" />
	<ReaderShell entry={entry} headings={headings} subgraph={subgraph}>
		<ArticleView
			entry={entry}
			Content={Content}
			headings={headings}
			readingTime={readingTime}
			backlinks={backlinks}
		/>
	</ReaderShell>
</BaseLayout>

<script>
	import '../scripts/charts.tsx';
	import '../scripts/abc.ts';
	import '../scripts/enhancements.js';
</script>
