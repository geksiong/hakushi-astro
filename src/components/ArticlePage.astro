---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ReaderShell from '../layouts/ReaderShell.astro';
import ArticleView from '../components/ArticleView.astro';
import { render, type CollectionEntry } from 'astro:content';
import { calculateReadingTime, getBacklinks, type ReadingTime, type Backlink } from '../lib/articles';
import { getCachedGraph, getSubgraph } from '../lib/graph-data';

export interface ArticlePageProps {
	entry: CollectionEntry<'docs' | 'blog' | 'research' | 'specs' | 'wiki'>;
}

const { entry } = Astro.props as ArticlePageProps;

const { Content, headings } = await render(entry);
const readingTime: ReadingTime = calculateReadingTime(entry.body ?? '');
const backlinks: Backlink[] = await getBacklinks(entry.id);
const subgraph = await getSubgraph(entry.id);

const title = `${entry.data.title} · Hakushi`;
---

<BaseLayout title={title} description={entry.data.summary ?? 'Hakushi article'}>
	<Header view="reader" />
	<ReaderShell entry={entry} headings={headings} subgraph={subgraph}>
		<ArticleView
			entry={entry}
			Content={Content}
			headings={headings}
			readingTime={readingTime}
			backlinks={backlinks}
		/>
	</ReaderShell>
</BaseLayout>

<script>
	import '../scripts/charts.tsx';
	import '../scripts/abc.ts';
	import '../scripts/enhancements.js';
</script>
