{
  "name": "hakushi",
  "type": "module",
  "version": "0.0.1",
  "description": "A configurable Astro knowledge-base integration with multiple collections, full-text search, themes, and a knowledge graph.",
  "keywords": ["astro", "documentation", "knowledge-base", "digital-garden", "integration"],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./loaders": {
      "types": "./loaders.d.ts",
      "default": "./loaders.mjs"
    },
    "./styles.css": "./src/styles/global.css"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "loaders.mjs",
    "loaders.d.ts",
    "README.md",
    "LICENSE",
    "src/components",
    "src/env.d.ts",
    "src/integration",
    "src/layouts",
    "src/lib",
    "src/plugins",
    "src/routes",
    "src/scripts",
    "src/styles"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/react": "^7.1.2",
    "@lucide/astro": "^1.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "abcjs": "^6.7.2",
    "astro-mermaid": "^2.2.0",
    "d3": "^7.9.0",
    "lucide-react": "^1.66.0",
    "lucide-static": "^1.66.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "^1.11.3",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "mdast-util-from-markdown": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
